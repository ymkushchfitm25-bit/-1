"""Модуль з функціями для демонстрації індексації, зрізів та мутації списків."""


def get_initial_temperatures() -> list[float]:
    """Повертає детермінований початковий список дійсних чисел (температур)."""
    # Копіюємо константний кортеж у новий змінюваний список
    INITIAL_DATA: tuple[float, ...] = (14.5, 16.2, 15.8, 18.0, 19.4, 17.1, 13.9)
    return list(INITIAL_DATA)


def demonstrate_indexing(data: list[float]) -> None:
    """Демонструє звернення до елементів за додатним та від'ємним індексами."""
    print("\n--- Крок 2. Звернення за індексами (читання без зміни списку) ---")
    first_elem = data[0]
    third_elem = data[2]
    last_elem = data[-1]
    penultimate_elem = data[-2]

    print(f"Перший елемент (індекс [0]): {first_elem}")
    print(f"Третій елемент (індекс [2]): {third_elem}")
    print(f"Останній елемент (індекс [-1]): {last_elem}")
    print(f"Передостанній елемент (індекс [-2]): {penultimate_elem}")


def demonstrate_slices(data: list[float]) -> None:
    """Формує три різні зрізи одного списку (створюються нові об'єкти list)."""
    print("\n--- Крок 3. Формування зрізів (створення нових списків) ---")

    # 1. Зріз із вказанням початку та кінця (крок за замовчуванням = 1)
    workdays_slice = data[0:5]
    print(f"Зріз [0:5] (перші 5 елементів, крок 1): {workdays_slice}")

    # 2. Зріз із кроком, відмінним від 1 (кожен другий елемент)
    step_two_slice = data[::2]
    print(f"Зріз [::2] (усі елементи з кроком 2): {step_two_slice}")

    # 3. Зріз із від'ємним кроком (зворотний порядок від передостаннього до другого)
    reverse_subslice = data[-2:0:-1]
    print(f"Зріз [-2:0:-1] (у зворотному порядку з кроком -1): {reverse_subslice}")

    print(f"Перевірка незмінності оригіналу після зрізів: {data}")


def demonstrate_in_place_mutations(data: list[float]) -> None:
    """Виконує 4 операції зміни вмісту списку 'на місці' з виводом після кожної."""
    print("\n--- Крок 4. Модифікація списку 'на місці' (in-place) ---")

    # Операція 1: Додавання елемента в кінець списку (append)
    data.append(15.0)
    print(f"4.1. Після додавання 15.0 у кінець (append): {data}")

    # Операція 2: Вставка елемента за індексом (insert)
    data.insert(2, 16.0)
    print(f"4.2. Після вставки 16.0 на позицію [2] (insert): {data}")

    # Операція 3: Заміна діапазону елементів через зріз зліва від '='
    data[1:3] = [16.5, 16.8]
    print(f"4.3. Після заміни діапазону [1:3] на [16.5, 16.8]: {data}")

    # Операція 4: Видалення елемента за індексом (pop)
    removed_val = data.pop(-2)
    print(f"4.4. Після видалення передостаннього елемента ({removed_val}) через pop(-2): {data}")
